  "components": [
    {
      "name": "文字行动链接",
      "kind": "button",
      "refersTo": "editorial-link",
      "description": "首页的无边框行动，以文字与箭头响应悬停。",
      "html": "<button class=\"ds-editorial\" type=\"button\"><span>认识我</span><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><path d=\"M6 18 18 6M6 6h12v12\"/></svg></button>",
      "css": ".ds-editorial{display:inline-flex;align-items:center;gap:22px;min-height:44px;padding:5px 0;border:0;background:none;color:var(--ink,#17211e);font:500 14px/1.2 'Space Grotesk Variable','Noto Sans SC Variable',sans-serif;cursor:pointer}.ds-editorial span{position:relative;padding:8px 0}.ds-editorial span:after{content:'';position:absolute;left:0;bottom:3px;width:100%;height:1px;background:currentColor;transform:scaleX(.25);transform-origin:left;transition:transform .45s cubic-bezier(.22,1,.36,1)}.ds-editorial svg{width:22px;height:22px;transition:transform .4s}.ds-editorial:hover span:after,.ds-editorial:focus-visible span:after{transform:scaleX(1)}.ds-editorial:hover svg{transform:translate(4px,-4px)}.ds-editorial:active svg{transform:translate(2px,-2px)}.ds-editorial:focus-visible{outline:2px solid #6ad8ee;outline-offset:5px}@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}"
    },
    {
      "name": "主按钮",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "弹窗、资料编辑和表单内的功能行动；首页使用文字行动链接。",
      "html": "<button class=\"ds-primary\" type=\"button\">保存资料</button>",
      "css": ".ds-primary{font-family:'Space Grotesk Variable','Noto Sans SC Variable',sans-serif;min-height:42px;border-radius:6px;padding:11px 18px;display:inline-flex;align-items:center;justify-content:center;gap:10px;font-size:13px;font-weight:600;cursor:pointer;touch-action:manipulation;color:var(--button-ink,#111827);background:var(--button,#f8fafc);border:0;box-shadow:inset 0 -3px 1px #0002;transition:transform .15s,background .15s}.ds-primary:hover{transform:translateY(-2px);filter:brightness(1.08)}.ds-primary:active{transform:translateY(2px);box-shadow:none}.ds-primary:disabled{opacity:.4;cursor:not-allowed}.ds-primary:focus-visible{outline:2px solid #6ad8ee;outline-offset:5px}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none!important;animation:none!important}}"
    },
    {
