      "html": "<button class=\"ds-secondary\" type=\"button\">取消</button>",
      "css": ".ds-secondary{font-family:'Space Grotesk Variable','Noto Sans SC Variable',sans-serif;min-height:42px;border-radius:6px;padding:11px 18px;display:inline-flex;align-items:center;justify-content:center;gap:10px;font-size:13px;font-weight:600;cursor:pointer;touch-action:manipulation;color:var(--ink,#f8fafc);background:var(--surface,#080e1c);border:1px solid var(--line,#273041);box-shadow:inset 0 -3px 1px #0002;transition:transform .15s,background .15s}.ds-secondary:hover{transform:translateY(-2px);filter:brightness(1.08)}.ds-secondary:active{transform:translateY(2px);box-shadow:none}.ds-secondary:disabled{opacity:.4;cursor:not-allowed}.ds-secondary:focus-visible{outline:2px solid #6ad8ee;outline-offset:5px}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none!important;animation:none!important}}"
